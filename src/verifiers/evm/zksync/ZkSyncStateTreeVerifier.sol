    /// @inheritdoc IZkSyncStateTreeVerifier
    /// @dev Anyone may call it: a record is a fact about `root` alone, and a bundle still has to
    ///      authenticate `root` itself (an executed batch on L1). Relayers use it to split one bundle's
    ///      tree proofs across transactions.
    function recordStorage(bytes32 root, address[] calldata accounts, bytes32[] calldata keys, bytes calldata proof)
        external
        returns (bytes32[] memory values)
    {
        // A fresh call frame: verifyStorage owns its memory.
        values = this.verifyStorage(root, accounts, keys, proof);
        for (uint256 i = 0; i < values.length; i++) {
            bytes32 slot = _recordSlot(root, accounts[i], keys[i]);
            bytes32 valueHash = keccak256(abi.encode(values[i]));
            assembly ("memory-safe") {
                sstore(slot, valueHash)
            }
            emit StorageRecorded(root, accounts[i], keys[i], values[i]);
        }
    }

    /// @inheritdoc IZkSyncStateTreeVerifier
    function recordedValueHash(bytes32 root, address account, bytes32 key) external view returns (bytes32 valueHash) {
        bytes32 slot = _recordSlot(root, account, key);
        assembly ("memory-safe") {
            valueHash := sload(slot)
        }
    }

    function _recordSlot(bytes32 root, address account, bytes32 key) private pure returns (bytes32) {
        return keccak256(abi.encode(root, account, key));
    }
